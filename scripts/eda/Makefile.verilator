# Verilator Simulation Makefile
# Home-Automation-SoC
# Usage: make -f Makefile.verilator [TARGET]

# Configuration
TOP_MODULE = has_soc
RTL_ROOT = ../../rtl
SIM_ROOT = ../../sim/sim_top

# Verilator flags
VERILATOR = verilator
VFLAGS = --cc --exe --trace --timing --assert -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT -Wno-UNUSED
VFLAGS += -I$(RTL_ROOT)/rtl_top -I$(RTL_ROOT)/rtl_peripherals
VFLAGS += -DVERILATOR_SIM -DVERILATOR
VFLAGS += --timescale-override 1ns/1ps

# Source files
RTL_SRCS = \
	$(RTL_ROOT)/rtl_top/has_soc.sv \
	$(RTL_ROOT)/rtl_top/riscv_core.sv \
	$(RTL_ROOT)/rtl_top/req_gnt_to_axi_lite.sv \
	$(RTL_ROOT)/rtl_top/axi_lite_interconnect.sv \
	$(RTL_ROOT)/rtl_top/has_addr_map.sv \
	$(RTL_ROOT)/rtl_top/boot_rom.sv \
	$(RTL_ROOT)/rtl_top/sram.sv \
	$(RTL_ROOT)/rtl_top/axi_lite_to_apb.sv \
	$(RTL_ROOT)/rtl_peripherals/uart.sv \
	$(RTL_ROOT)/rtl_peripherals/gpio.sv \
	$(RTL_ROOT)/rtl_peripherals/i2c_ctrl.sv \
	$(RTL_ROOT)/rtl_peripherals/spi_ctrl.sv \
	$(RTL_ROOT)/rtl_peripherals/pwm.sv \
	$(RTL_ROOT)/rtl_peripherals/timer.sv \
	$(RTL_ROOT)/rtl_peripherals/watchdog.sv \
	$(RTL_ROOT)/rtl_peripherals/i2s.sv \
	$(RTL_ROOT)/rtl_peripherals/qspi_flash_ctrl.sv \
	$(RTL_ROOT)/rtl_peripherals/clint.sv \
	$(RTL_ROOT)/rtl_peripherals/plic.sv \
	$(RTL_ROOT)/rtl_peripherals/debug_jtag.sv \
	$(RTL_ROOT)/rtl_peripherals/power_mgr.sv \
	$(RTL_ROOT)/rtl_peripherals/power_mgr_regs.sv

# C++ testbench
TB_CPP = $(SIM_ROOT)/sim_main.cpp

# Build directory
OBJ_DIR = obj_dir
EXE = $(OBJ_DIR)/V$(TOP_MODULE)

# Default target
all: $(EXE)

# Compile with Verilator
$(EXE): $(RTL_SRCS) $(TB_CPP)
	@mkdir -p $(OBJ_DIR)
	$(VERILATOR) $(VFLAGS) --top-module $(TOP_MODULE) \
		$(RTL_SRCS) $(TB_CPP) \
		-o $(EXE)

# Run simulation
run: $(EXE)
	./$(EXE)

# Run with waveform (VCD)
run_wave: $(EXE)
	./$(EXE) +trace

# Clean
clean:
	rm -rf $(OBJ_DIR) waveforms/*.vcd

# Lint only (no compilation)
lint:
	$(VERILATOR) $(VFLAGS) --lint-only --top-module $(TOP_MODULE) $(RTL_SRCS)

# Show hierarchy
hierarchy:
	$(VERILATOR) $(VFLAGS) --top-module $(TOP_MODULE) $(RTL_SRCS) --hierarchy

# Check for SystemVerilog constructs
sv_check:
	$(VERILATOR) $(VFLAGS) --top-module $(TOP_MODULE) $(RTL_SRCS) --sv

.PHONY: all run run_wave clean lint hierarchy sv_check