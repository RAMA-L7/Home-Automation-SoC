# .gitattributes - Home-Automation-SoC
# Establish consistent LF line endings for engineering source files across
# Windows and Linux hosts. Binary/generated artifacts are marked -text.

# --- Source code: force LF ---
*.sv         text eol=lf
*.svh        text eol=lf
*.v          text eol=lf
*.vh         text eol=lf
*.vhd        text eol=lf
*.vhdl       text eol=lf
*.c          text eol=lf
*.h          text eol=lf
*.cpp        text eol=lf
*.cc         text eol=lf
*.cxx        text eol=lf
*.hpp        text eol=lf
*.rs         text eol=lf
*.py         text eol=lf
*.sh         text eol=lf
*.bash       text eol=lf
*.tcl        text eol=lf
*.perl       text eol=lf
*.rb         text eol=lf
*.makefile   text eol=lf
*.mk         text eol=lf
Makefile     text eol=lf

# --- Constraint / EDA text files ---
*.sdc        text eol=lf
*.xdc        text eol=lf
*.pdc        text eol=lf
*.qsys       text eol=lf
*.ipx        text eol=lf

# --- Documentation and config ---
*.md         text eol=lf
*.txt        text eol=lf
*.rst        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.toml       text eol=lf
*.ini        text eol=lf
*.cfg        text eol=lf
*.csv        text eol=lf

